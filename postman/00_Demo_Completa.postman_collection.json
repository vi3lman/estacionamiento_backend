          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const finalizarDesde = Number(pm.environment.get('finalizarDesde') || 0);",
              "while (finalizarDesde && Date.now() < finalizarDesde) {}"
            ]
