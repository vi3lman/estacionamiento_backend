    {
      "name": "02 - Crear calle",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now();",
              "pm.environment.set('calleNombre', `Demo Calle ${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.environment.set('calleId', json.id_calle);",
              "pm.test('Guarda calleId', function () { pm.expect(json.id_calle).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre_calle\": \"{{calleNombre}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/calles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "calles"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - Listar calles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const calles = pm.response.json();",
              "const creada = calles.find(c => c.nombre_calle === pm.environment.get('calleNombre'));",
              "if (creada) pm.environment.set('calleId', creada.id_calle);",
              "pm.test('Respuesta es lista', function () { pm.expect(calles).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/calles?skip=0&limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "calles"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "100"
            }
          ]
        }
      },
      "response": []
    },
