    {
      "name": "13 - Crear ocupacion corta para finalizar",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now();",
              "const start = Date.now() + 5000;",
              "pm.environment.set('fechaInicioFutura', new Date(start).toISOString());",
              "pm.environment.set('finalizarDesde', String(start + 1000));",
              "pm.environment.set('docDemo', `CI-FIN-${stamp}`);",
              "pm.environment.set('chapaDemo', `FIN${String(stamp).slice(-6)}`);",
              "pm.environment.set('tiempoEstimado', '30');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.environment.set('ocupacionFinalizarId', json.id_ocupacion);"
            ]
          }
        }
