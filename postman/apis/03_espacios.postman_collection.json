{
  "info": {
    "_postman_id": "66523109-f96d-4354-9915-ae53d94ef303",
    "name": "API Estacionamiento - Espacios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /espacios - crear espacio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.environment.set('espacioId', json.id_espacio);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_calle\": {{calleId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/espacios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "espacios"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /espacios/{id_calle} - listar por calle",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const espacios = pm.response.json();",
              "if (espacios.length > 0) pm.environment.set('espacioId', espacios[0].id_espacio);",
              "pm.test('Respuesta es lista', function () { pm.expect(espacios).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/espacios/{{calleId}}?skip=0&limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "espacios",
            "{{calleId}}"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "100"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET /espacios/libres/{id_calle} - espacios libres",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('fechaInicioFutura', new Date(Date.now() + 10 * 60 * 60 * 1000).toISOString());",
              "pm.environment.set('tiempoEstimado', '120');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Respuesta es lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/espacios/libres/{{calleId}}?fecha_hora_ingreso={{fechaInicioFutura}}&tiempo_estimado={{tiempoEstimado}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "espacios",
            "libres",
            "{{calleId}}"
          ],
          "query": [
            {
              "key": "fecha_hora_ingreso",
              "value": "{{fechaInicioFutura}}"
            },
            {
              "key": "tiempo_estimado",
              "value": "{{tiempoEstimado}}"
            }
          ]
        }
      },
      "response": []
    }
  ]
}
